# Paste this template into the Dokploy Environment tab for the production
# Compose service. Do not commit real credentials or secrets.
# Production and stable must use different database credentials and secrets.
#
# Public hostname only; do not include a scheme or trailing slash.
DOMAIN=construction.example.com

# Use URL-safe values because these are interpolated into MySQL DSNs.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate at least 32 random bytes, for example: openssl rand -hex 32
SESSION_SECRET=
